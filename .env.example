# Copy this file to `.env` and set your own values (`.env` is git-ignored)
ADMIN_EMAIL=admin@dryfruitadda.in
ADMIN_PASSWORD=change-me-to-a-strong-password

# MongoDB — Atlas connection string (database = ismein diya hua default naam)
MONGODB_URI=mongodb+srv://user:pass@cluster/cluster?retryWrites=true&w=majority
# Optional: database name override. TEST/CI me lagao taaki tests production
# data ko chhunein bhi na (default: URI ke connection ka database, jaise
# "dryfruitadda"). `npm test` khud dryfruitadda_test lagata hai agar set na ho.
# MONGODB_DB=dryfruitadda_test

# Public site URL — sitemap, canonical aur OG tags ke liye
NEXT_PUBLIC_SITE_URL=https://www.dryfruitaddaa.in

# Razorpay — test/live keys (https://dashboard.razorpay.com → Settings → API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx

# SMTP email — set SMTP_HOST to enable real email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
SMTP_FROM=Dryfruit Adda <no-reply@dryfruitadda.in>
SMTP_TEST_TO=
QUERY_NOTIFY_EMAILS=info@dryfruitadda.in,dryfruitadda5@gmail.com

# Sanity CMS — blog content (public project, read-only)
NEXT_PUBLIC_SANITY_PROJECT_ID=inq7tvs6
NEXT_PUBLIC_SANITY_DATASET=production
# Sanity organization (owner of project inq7tvs6 — used by create-sanity --organization)
# SANITY_ORGANIZATION_ID=oiogzlqe8
SANITY_API_TOKEN=
