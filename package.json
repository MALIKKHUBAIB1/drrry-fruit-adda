{
  "name": "dryfruit-adda-nextjs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.ts,.tsx --max-warnings 0",
    "test": "node --import tsx --test",
    "test:coverage": "node --import tsx --test --experimental-test-coverage",
    "test:security": "tsx --test tests/security/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:load": "node tests/load/node-load.mjs",
    "audit:deps": "npm audit --audit-level=moderate",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "qa:ci": "npm run lint && npm run test && npm run test:security && npm run build",
    "typecheck": "tsc --noEmit",
    "qa": "bash scripts/qa-gate.sh",
    "db:migrate": "node scripts/migrate-json-to-mongo.mjs",
    "db:migrate:write": "node scripts/migrate-json-to-mongo.mjs --write",
    "db:split": "node scripts/migrate-split-collections.mjs",
    "db:split:write": "node scripts/migrate-split-collections.mjs --write",
    "db:indexes": "node scripts/create-indexes.mjs"
  },
